FROM node:24-alpine AS build
WORKDIR /src

COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci

COPY src/web/ ./
RUN npm run build

FROM nginx:1.29-alpine AS runtime

COPY --from=build /src/dist/ /usr/share/nginx/html/
COPY src/web/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY src/web/docker/entrypoint.sh /docker-entrypoint.d/40-relego-config.sh
RUN chmod +x /docker-entrypoint.d/40-relego-config.sh

# Where the browser should reach relego-server. Rewritten into config.js at start-up.
ENV RELEGO_API_URL=http://localhost:8080

EXPOSE 8081
