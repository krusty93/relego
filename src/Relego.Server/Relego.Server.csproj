<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\PackageVersions.props" />

  <ItemGroup>
    <ProjectReference Include="..\Relego.Core\Relego.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Polly" Version="$(PollyVersion)" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.1" />
    <PackageReference Include="Quartz.Plugins.TimeZoneConverter" Version="3.18.1" />
    <PackageReference Include="Quartz.Serialization.Json" Version="3.18.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <Version>0.18.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Relego.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Database\quartz-sqlite.sql" />
    <EmbeddedResource Include="Assets\epub-cover.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      SQLitePCLRaw.lib.e_sqlite3 (transitive via SQLitePCLRaw.bundle_e_sqlite3) is flagged by
      GHSA-2m69-gcr7-jv3q (SQLite < 3.50.2 memory corruption, CVE-2025-6965).
      Mitigation: SourceGear.sqlite3 3.50.4.5 is an explicit dependency that places the patched
      SQLite 3.50.4 binary in the output directory, overriding the vulnerable transitive binary.
      The advisory is suppressed here because the actual runtime binary is the patched one.
      Remove this suppression once SQLitePCLRaw.bundle_e_sqlite3 (via Microsoft.Data.Sqlite) ships a version that depends
      on SourceGear.sqlite3 directly.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
