{
  "name": "@relego/extension",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Relego browser extension: reads Kindle Notebook highlights in the user's own Amazon session and pushes them to the user's Relego server.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
