---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../config/site';
---

<Layout title="Page not found" description="That page does not exist on relego.app.">
	<Navbar />
	<main class="mx-auto flex min-h-[70vh] max-w-2xl flex-col justify-center px-6 pt-24 pb-16">
		<p class="font-['Playfair_Display'] text-6xl font-light text-[var(--color-accent)]">404</p>
		<h1 class="mt-4 font-['Playfair_Display'] text-3xl font-light sm:text-4xl">
			This page was never highlighted.
		</h1>
		<p class="mt-4 max-w-prose text-[var(--color-text)]/70">
			The address you followed does not exist. The documentation is the best place to
			pick the thread back up.
		</p>
		<div class="mt-8 flex flex-wrap gap-4">
			<Button href={siteConfig.docsUrl} variant="primary">Read the docs</Button>
			<Button href="/" variant="outline">Back to {siteConfig.logotype}</Button>
		</div>
	</main>
	<Footer />
</Layout>
