---
import { siteConfig } from '../config/site';
import Button from './Button.astro';

const points = [
	{
		title: 'Syncs in the background',
		body: 'Pick a cadence on the Sync page, from every 15 minutes to once a day. Runs missed while the browser was closed never pile up.',
	},
	{
		title: 'Your session, not your password',
		body: 'You sign in on Amazon’s own pages. Relego never asks for your Amazon password, and only parsed highlights leave the browser.',
	},
	{
		title: 'Eight marketplaces',
		body: 'United States, Canada, United Kingdom, Germany, France, Italy, Spain and Brazil, including highlights made in the Kindle apps.',
	},
];
---

<section id="kindle-sync" class="sync">
	<div class="wrap sync__grid">
		<div class="sync__copy">
			<h2 class="headline" data-reveal>Skip the <span>cable</span></h2>
			<p class="lede" data-reveal style="--d:1">
				A small browser extension reads your Kindle Notebook in your own Amazon session and hands the highlights to your server, on a schedule the browser keeps while it is open.
			</p>

			<ul class="sync__points">
				{points.map((point, i) => (
					<li data-reveal style={`--d:${i + 2}`}>
						<h3>{point.title}</h3>
						<p>{point.body}</p>
					</li>
				))}
			</ul>

			<div class="sync__actions" data-reveal style="--d:5">
				<Button href={siteConfig.extensionUrl} variant="primary" target="_blank" rel="noopener noreferrer" arrow>
					Get the extension
				</Button>
				<Button href={siteConfig.extensionFirefoxUrl} variant="outline" target="_blank" rel="noopener noreferrer">
					Firefox Add-ons
				</Button>
			</div>
			<p class="sync__note" data-reveal style="--d:6">
				Optional. Chrome, Edge and Firefox 140 or later. The{' '}
				<a href={siteConfig.extensionDocsUrl}>setup guide</a> covers pairing and regions, and{' '}
				<a href={siteConfig.docsImportUrl}>USB import</a> works without it.
			</p>
		</div>

		<div class="sync__object" data-reveal style="--d:2">
			<div class="ext" aria-hidden="true">
				<div class="ext__head">
					<span class="ext__mark">relego<span>.</span></span>
					<svg class="ext__popout" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9.5 2.5h4v4" />
						<path d="M13.5 2.5 8 8" />
						<path d="M12 9.5v3a1 1 0 0 1-1 1H3.5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3" />
					</svg>
				</div>

				<p class="ext__reading">Reading United Kingdom · read.amazon.co.uk</p>
				<p class="ext__label">Configuration complete</p>
				<p class="ext__note">Relego reads your Kindle Notebook from this browser on its own schedule.</p>

				<p class="ext__buttons">
					<span>Edit configuration</span>
					<span>Open Relego</span>
				</p>

				<span class="ext__rail"><span></span></span>
			</div>
		</div>
	</div>
</section>

<style>
	.sync {
		padding-block: clamp(5rem, 10vw, 8rem);
	}

	.sync__grid {
		display: grid;
		gap: 3.5rem;
		align-items: start;
	}

	.sync__copy {
		max-width: 34rem;
	}

	.sync__points {
		margin: 2.75rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.sync__points li {
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.sync__points h3 {
		margin: 0 0 0.4rem;
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.sync__points p {
		margin: 0;
		max-width: 32rem;
		font-size: 0.9375rem;
		line-height: 1.7;
		color: var(--color-soft);
	}

	.sync__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.sync__note {
		margin: 1rem 0 0;
		max-width: 30rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-soft);
	}

	.sync__note a {
		color: var(--color-link);
		text-underline-offset: 0.2em;
	}

	.sync__note a:hover {
		text-decoration: underline;
	}

	.sync__object {
		display: flex;
		justify-content: center;
	}

	/* Depicted surface: the extension popup itself, so it may carry a frame and depth. */
	.ext {
		width: 100%;
		max-width: 21rem;
		padding: 1.2rem 1.25rem 1.1rem;
		box-sizing: border-box;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.9rem;
		background: var(--color-panel);
		box-shadow: 0 2.25rem 4.5rem -2.25rem color-mix(in srgb, var(--color-text) 32%, transparent);
	}

	.ext__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--color-border);
	}

	.ext__mark {
		font-family: var(--font-display);
		font-size: 1.4em;
		font-weight: 400;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.ext__mark span {
		color: var(--color-accent);
	}

	.ext__popout {
		width: 0.95rem;
		height: 0.95rem;
		color: var(--color-soft);
	}

	.ext__reading {
		margin: 0.85rem 0 0;
		font-size: 0.8125em;
		line-height: 1.5;
		color: var(--color-text);
	}

	.ext__label {
		margin: 1rem 0 0.35rem;
		font-size: 0.75em;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--color-soft);
	}

	.ext__note {
		margin: 0;
		font-size: 0.75em;
		line-height: 1.6;
		color: var(--color-soft);
	}

	.ext__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
	}

	.ext__buttons span {
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.5rem;
		font-size: 0.75em;
		font-weight: 600;
		color: var(--color-text);
	}

	.ext__rail {
		display: block;
		height: 2px;
		margin-top: 1rem;
		overflow: hidden;
		background: var(--color-border);
	}

	.ext__rail span {
		display: block;
		height: 100%;
		background: var(--color-accent);
		transform-origin: left;
		transform: scaleX(0.62);
	}

	:global(.motion) .ext__rail span {
		transform: scaleX(0);
		transition: transform 2s var(--ease-in-out) 0.5s;
	}

	:global(.motion) .sync__object.is-in .ext__rail span {
		transform: scaleX(0.62);
	}

	@media (min-width: 60rem) {
		.sync__grid {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
			gap: 5rem;
			align-items: center;
		}

		.sync__object {
			justify-content: center;
		}
	}
</style>
