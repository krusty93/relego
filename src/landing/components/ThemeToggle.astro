---
---

<button type="button" aria-label="Toggle theme" class="toggle" id="theme-toggle">
	<svg class="toggle__sun" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
		<circle cx="12" cy="12" r="4.5" />
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
	</svg>
	<svg class="toggle__moon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
		<path d="M20.5 13.1A8.5 8.5 0 1 1 10.9 3.5a6.6 6.6 0 0 0 9.6 9.6z" />
	</svg>
</button>

<style>
	.toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		transition: background-color 0.25s var(--ease-out);
	}

	.toggle:hover {
		background: color-mix(in srgb, var(--color-text) 6%, transparent);
	}

	.toggle svg {
		position: absolute;
		width: 1.15rem;
		height: 1.15rem;
		transition:
			transform 0.6s var(--ease-out),
			opacity 0.3s var(--ease-out);
	}

	.toggle__sun {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}

	:global([data-theme='dark']) .toggle__sun {
		opacity: 1;
		transform: none;
	}

	:global([data-theme='dark']) .toggle__moon {
		opacity: 0;
		transform: rotate(90deg) scale(0.6);
	}
</style>

<script>
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const html = document.documentElement;
		const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		const apply = () => html.setAttribute('data-theme', next);
		const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
		if (doc.startViewTransition && html.classList.contains('motion')) {
			doc.startViewTransition(apply);
		} else {
			apply();
		}
		try {
			localStorage.setItem('theme', next);
			// Keep the Starlight-powered /docs routes on the same choice.
			localStorage.setItem('starlight-theme', next);
		} catch {
			// localStorage unavailable
		}
	});
</script>
