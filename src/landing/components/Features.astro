---
const features = [
	{
		title: 'Grouped by book',
		body: 'Every highlight sits under the book it came from, Kindle and Kobo side by side. Find any passage in seconds.',
		icon: '<path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5C4.7 20 4 19.3 4 18.5z"/><path d="M13 4h5.5c.8 0 1.5.7 1.5 1.5v13c0 .8-.7 1.5-1.5 1.5H13z"/><path d="M6.5 8h2M6.5 11h2M15.5 8h2"/>',
	},
	{
		title: 'Built for e-ink',
		body: 'Recaps arrive as clean EPUB documents or plain HTML emails. Black text, generous margins, nothing that flickers.',
		icon: '<rect x="5.5" y="2.5" width="13" height="19" rx="2"/><path d="M8.5 7h7M8.5 10h7M8.5 13h4.5"/><path d="M10.5 18.5h3"/>',
	},
	{
		title: 'No lock-in',
		body: 'Your highlights live in a single SQLite file on your server. Back it up, open it with any tool, or delete it.',
		icon: '<ellipse cx="12" cy="6" rx="7" ry="2.75"/><path d="M5 6v12c0 1.5 3.1 2.75 7 2.75s7-1.25 7-2.75V6"/><path d="M5 12c0 1.5 3.1 2.75 7 2.75s7-1.25 7-2.75"/>',
	},
	{
		title: 'Privacy',
		body: 'Relego runs on your own network, with no Relego account and no tracking. Recaps leave through the SMTP server you choose.',
		icon: '<path d="M12 2.75 4.5 5.5v6c0 4.6 3.1 8.4 7.5 9.75 4.4-1.35 7.5-5.15 7.5-9.75v-6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
	},
];
---

<section id="features" class="features">
	<div class="wrap">
		<div class="features__head">
			<h2 class="headline" data-reveal>Built for readers</h2>
			<p class="lede" data-reveal style="--d:1">Everything you need to rediscover your highlights. Nothing you don’t.</p>
		</div>

		<ul class="features__grid">
			{features.map((f, i) => (
				<li class="feature" data-reveal style={`--d:${i}`}>
					<svg class="feature__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon.replace(/<(path|rect|ellipse)/g, '<$1 pathLength="1"')} />
					<h3>{f.title}</h3>
					<p>{f.body}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.features {
		padding-block: clamp(6rem, 12vw, 10rem);
	}

	.features__head {
		max-width: 44rem;
	}

	.features__grid {
		display: grid;
		margin: 3.5rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.feature {
		position: relative;
		padding: 2.25rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.feature::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.7s var(--ease-out);
	}

	.feature:hover::before {
		transform: scaleX(1);
	}

	.feature__icon {
		width: 2.5rem;
		height: 2.5rem;
		color: var(--color-accent);
	}

	.feature__icon :global(*) {
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	:global(.motion) .feature .feature__icon :global(*) {
		stroke-dashoffset: 1;
		transition: stroke-dashoffset 1.4s var(--ease-in-out) calc(var(--d, 0) * 90ms + 0.25s);
	}

	:global(.motion) .feature.is-in .feature__icon :global(*) {
		stroke-dashoffset: 0;
	}

	.feature h3 {
		margin: 1.5rem 0 0.6rem;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: 1.6rem;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.feature p {
		margin: 0;
		max-width: 22rem;
		line-height: 1.7;
		color: var(--color-soft);
	}

	@media (min-width: 40rem) {
		.features__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.feature {
			padding-inline: 0 2rem;
		}

		.feature:nth-child(even) {
			padding-inline: 2rem 0;
			border-left: 1px solid var(--color-border);
		}
	}

	@media (min-width: 64rem) {
		.features__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.feature,
		.feature:nth-child(even) {
			padding-inline: 1.75rem;
			border-left: 1px solid var(--color-border);
		}

		.feature:first-child {
			padding-left: 0;
			border-left: 0;
		}
	}
</style>
