---
const statement =
	'The best lines you read vanish into a file you never open again. Relego finds them and | hands them back | on the screen where you first underlined them.';
const parts = statement.split('|').map((chunk, i) => ({ text: chunk.trim(), mark: i === 1 }));

const columns = [
	{
		title: 'The problem',
		body: 'You highlight passages while reading, then they sit in My Clippings.txt or a Kobo database. Without something to bring them back, the ideas that stopped you fade.',
	},
	{
		title: 'The name',
		body: 'From Latin re-lego, “to read again”. Relego resurfaces highlights by weight and by how long since you last saw them, so a line that struck you once can strike again.',
		latin: true,
	},
	{
		title: 'The difference',
		body: 'Free, open source and self-hosted. No cloud account, no subscription, no tracking. Your reading data stays on hardware you control.',
	},
];
---

<section id="why-relego" class="why">
	<div class="wrap">
		<h2 class="headline why__title" data-reveal>Why Relego <span>is different</span></h2>

		<p class="why__statement" data-progress="enter" data-lit>
			{parts.map((part) =>
				part.mark ? (
					<span class="mark why__mark">
						{part.text.split(' ').map((word) => <span class="why__word">{word} </span>)}
					</span>
				) : (
					part.text.split(' ').map((word) => <span class="why__word">{word} </span>)
				),
			)}
		</p>

		<div class="why__cols">
			{columns.map((col, i) => (
				<div class="why__col" data-reveal style={`--d:${i}`}>
					<h3>{col.title}</h3>
					{col.latin ? (
						<p>
							From Latin <em lang="la">re-lego</em>, “to read again”. Relego resurfaces highlights by weight and by how long since you last saw them, so a line that struck you once can strike again.
						</p>
					) : (
						<p>{col.body}</p>
					)}
				</div>
			))}
		</div>
	</div>
</section>

<script>
	const statement = document.querySelector<HTMLElement>('[data-lit]');
	if (statement && document.documentElement.classList.contains('motion')) {
		const words = Array.from(statement.querySelectorAll<HTMLElement>('.why__word'));
		const mark = statement.querySelector<HTMLElement>('.why__mark');
		let lit = -1;
		statement.addEventListener('relego:progress', (event) => {
			const p = (event as CustomEvent<number>).detail;
			const next = Math.round(Math.min(1, p * 1.15) * words.length);
			if (next === lit) return;
			lit = next;
			words.forEach((word, i) => word.classList.toggle('is-lit', i < next));
			mark?.classList.toggle('is-lit', next >= words.length);
		});
	}
</script>

<style>
	.why {
		padding-block: clamp(6rem, 12vw, 10rem);
	}

	.why__statement {
		max-width: 58rem;
		margin: 3rem 0 0;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3.5rem);
		line-height: 1.18;
		letter-spacing: -0.02em;
		color: var(--color-text);
		text-wrap: pretty;
	}

	:global(.motion) .why__word {
		color: var(--color-soft);
		transition: color 0.35s var(--ease-out);
	}

	:global(.motion) .why__word.is-lit {
		color: var(--color-text);
	}

	:global(.motion) .why__mark {
		background-size: 0% 0.62em;
		transition: background-size 1.1s var(--ease-in-out);
	}

	:global(.motion) .why__mark.is-lit {
		background-size: 100% 0.62em;
	}

	.why__cols {
		display: grid;
		gap: 2.5rem;
		margin-top: clamp(4rem, 8vw, 6rem);
		border-top: 1px solid var(--color-border);
		padding-top: 2.5rem;
	}

	.why__col h3 {
		margin: 0 0 0.75rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.why__col p {
		margin: 0;
		line-height: 1.75;
		color: var(--color-soft);
	}

	.why__col em {
		font-family: var(--font-display);
		font-size: 1.1em;
		color: var(--color-text);
	}

	@media (min-width: 48rem) {
		.why__cols {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0;
		}

		.why__col {
			padding-inline: 2rem;
			border-left: 1px solid var(--color-border);
		}

		.why__col:first-child {
			padding-left: 0;
			border-left: 0;
		}
	}
</style>
