---
interface Props {
	question: string;
}

const { question } = Astro.props;
---

<details class="qa" name="faq">
	<summary class="qa__q">
		<span>{question}</span>
		<svg class="qa__icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
			<path d="M3 8h10" />
			<path class="qa__v" d="M8 3v10" />
		</svg>
	</summary>
	<div class="qa__a"><slot /></div>
</details>

<style>
	.qa {
		border-bottom: 1px solid var(--color-border);
		interpolate-size: allow-keywords;
	}

	.qa::details-content {
		block-size: 0;
		overflow: clip;
		transition:
			block-size 0.45s var(--ease-out),
			content-visibility 0.45s allow-discrete;
	}

	.qa[open]::details-content {
		block-size: auto;
	}

	.qa__q {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.5rem 0;
		list-style: none;
		cursor: pointer;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
		line-height: 1.3;
		color: var(--color-text);
		transition: color 0.25s var(--ease-out);
	}

	.qa__q::-webkit-details-marker {
		display: none;
	}

	.qa__q:hover {
		color: var(--color-accent);
	}

	.qa__icon {
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		color: var(--color-accent);
		transition: transform 0.45s var(--ease-out);
	}

	.qa__v {
		transform-origin: center;
		transition: transform 0.45s var(--ease-out);
	}

	.qa[open] .qa__icon {
		transform: rotate(180deg);
	}

	.qa[open] .qa__v {
		transform: scaleY(0);
	}

	.qa__a {
		max-width: 40rem;
		padding-bottom: 1.75rem;
		line-height: 1.75;
		color: var(--color-soft);
	}

	.qa__a :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		color: var(--color-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.qa::details-content,
		.qa__icon,
		.qa__v {
			transition: none;
		}
	}
</style>
