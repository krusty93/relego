---
const command = 'docker compose --profile app up -d';
---

<div class="command" data-docker-command>
	<div class="command__line">
		<code><span aria-hidden="true">$ </span>{command}</code>
		<button type="button" class="command__copy" data-copy={command} aria-label="Copy command" hidden>
			<svg class="command__copy-idle" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5V3A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" /></svg>
			<svg class="command__copy-done" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7" /></svg>
		</button>
	</div>
	<span class="sr-only" aria-live="polite" data-copy-status></span>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-docker-command]').forEach((container) => {
		const button = container.querySelector<HTMLButtonElement>('[data-copy]');
		const status = container.querySelector<HTMLElement>('[data-copy-status]');
		if (!button || !status) {
			console.error('Docker command copy controls are incomplete. Copy the displayed command manually.');
			return;
		}

		let timeout = 0;
		let pending = false;
		button.hidden = false;
		button.addEventListener('click', async () => {
			if (pending) return;
			pending = true;
			button.setAttribute('aria-busy', 'true');
			window.clearTimeout(timeout);
			button.classList.remove('is-done');
			status.classList.add('sr-only');
			status.textContent = '';
			try {
				const value = button.dataset.copy;
				if (!value) throw new Error('Docker command is unavailable.');
				await navigator.clipboard.writeText(value);
				button.classList.add('is-done');
				status.textContent = 'Command copied';
				timeout = window.setTimeout(() => {
					button.classList.remove('is-done');
					status.textContent = '';
				}, 1800);
			} catch {
				status.classList.remove('sr-only');
				status.textContent = 'Copy failed. Select the command and copy it manually.';
			} finally {
				pending = false;
				button.removeAttribute('aria-busy');
			}
		});
	});
</script>

<style>
	.command {
		display: inline-flex;
		flex-direction: column;
		max-width: 100%;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.6rem;
		background: var(--color-panel);
	}

	.command__line {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		padding: 0.45rem 0.45rem 0.45rem 1.1rem;
	}

	.command code {
		min-width: 0;
		white-space: normal;
		overflow-wrap: anywhere;
		text-align: left;
		font: 0.9rem/1.5 var(--font-mono);
		color: var(--color-text);
	}

	.command code span {
		color: var(--color-accent);
	}

	.command__copy {
		position: relative;
		display: grid;
		place-items: center;
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 0.4rem;
		background: none;
		color: var(--color-soft);
		cursor: pointer;
		transition:
			background-color 0.2s var(--ease-out),
			color 0.2s var(--ease-out);
	}

	.command__copy[hidden] {
		display: none;
	}

	.command__copy:hover {
		background: color-mix(in srgb, var(--color-text) 7%, transparent);
		color: var(--color-text);
	}

	.command__copy svg {
		grid-area: 1 / 1;
		width: 1rem;
		height: 1rem;
		transition:
			opacity 0.2s var(--ease-out),
			transform 0.3s var(--ease-out);
	}

	.command__copy-done {
		opacity: 0;
		transform: scale(0.6);
		color: var(--color-accent);
	}

	.command__copy.is-done .command__copy-idle {
		opacity: 0;
		transform: scale(0.6);
	}

	.command__copy.is-done .command__copy-done {
		opacity: 1;
		transform: none;
	}

	[data-copy-status]:not(.sr-only) {
		padding: 0 1.1rem 0.75rem;
		font-size: 0.875rem;
		line-height: 1.5;
		text-align: left;
		color: var(--color-soft);
	}
</style>
