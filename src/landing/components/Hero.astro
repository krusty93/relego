---
import { siteConfig } from '../config/site';
import Button from './Button.astro';
import Reader from './Reader.astro';

const letters = siteConfig.logotype.split('');
---

<section id="hero" class="hero" data-progress="leave">
	<div class="hero__wash" aria-hidden="true"></div>
	<div class="hero__grid wrap">
		<div class="hero__copy">
			<h1 class="hero__title" aria-label={siteConfig.logotype}>
				{letters.map((letter, i) => (
					<span class="hero__letter" style={`--i:${i}`} aria-hidden="true">{letter}</span>
				))}
			</h1>
			<div class="hero__statement">
				Every line you underline, <span class="mark hero__mark">read again</span>.
			</div>
			<p class="hero__tagline">{siteConfig.tagline}</p>
			<div class="hero__actions">
				<Button href="#getting-started" variant="primary" arrow>Get started</Button>
				<Button href="#journey" variant="outline">See how it works</Button>
			</div>
			<ul class="hero__facts" aria-label="At a glance">
				<li>Kindle &amp; Kobo</li>
				<li>Self-hosted</li>
				<li>Open source, MIT</li>
			</ul>
		</div>

		<div class="hero__device">
			<Reader class="hero__reader" label="Sample recap">
				<div class="recap">
					<div class="recap__head">
						<span class="recap__logo">relego.</span>
						<span>Recap · 5 highlights</span>
					</div>
					<div class="recap__title">Your recap</div>
					<blockquote class="recap__quote">
						<span class="recap__mark">I went to the woods because I wished to live 						deliberately,</span>{' '}
						to front only the essential facts of life, and see if I could not learn what it had to teach.
					</blockquote>
					<div class="recap__book">Walden · Henry David Thoreau</div>
					<span class="recap__rule"></span>
					<blockquote class="recap__quote recap__quote--next">
						It is not down in any map; true places never are.
					</blockquote>
					<div class="recap__book">Moby-Dick · Herman Melville</div>
					<div class="recap__foot">1 / 5</div>
				</div>
			</Reader>
		</div>
	</div>
	<a class="hero__cue" href="#journey" aria-label="Scroll to how it works">
		<span></span>
	</a>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 6.5rem 0 4rem;
		box-sizing: border-box;
	}

	.hero__wash {
		position: absolute;
		inset: -10% -10% auto auto;
		width: 75vw;
		height: 90vh;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent);
		pointer-events: none;
	}

	:global(.motion) .hero__wash {
		opacity: calc(1 - var(--p, 0));
	}

	.hero__grid {
		position: relative;
		display: grid;
		gap: 3.5rem;
		align-items: center;
	}

	.hero__copy {
		max-width: 36rem;
	}

	:global(.motion) .hero__copy {
		opacity: calc(1 - var(--p, 0) * 1.3);
		transform: translate3d(0, calc(var(--p, 0) * -4rem), 0);
		filter: blur(calc(var(--p, 0) * 6px));
	}

	.hero__title {
		margin: 0 0 1.35rem;
		padding-bottom: 0.15em;
		overflow: clip;
		font-size: clamp(4rem, 2.6rem + 6vw, 6rem);
		line-height: 0.9;
		letter-spacing: -0.035em;
		color: var(--color-text);
	}

	.hero__letter {
		display: inline-block;
	}

	.hero__letter:last-child {
		color: var(--color-accent);
	}

	/* Entrances never touch opacity: text keeps full contrast at every frame. */
	:global(.motion) .hero__letter {
		animation: letter-rise 1.1s var(--ease-out) backwards;
		animation-delay: calc(var(--i) * 55ms + 100ms);
	}

	@keyframes letter-rise {
		from {
			transform: translateY(115%);
		}
	}

	.hero__statement {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-text);
		text-wrap: balance;
	}

	:global(.motion) .hero__mark {
		animation: mark-sweep 1.3s var(--ease-in-out) 0.9s both;
	}

	@keyframes mark-sweep {
		from {
			background-size: 0% 0.62em;
		}
	}

	.hero__tagline {
		margin: 1.5rem 0 0;
		max-width: 30rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--color-soft);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.hero__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 2.5rem 0 0;
		padding: 1.25rem 0 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
		font-size: 0.875rem;
		color: var(--color-soft);
	}

	.hero__facts li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.hero__facts li::before {
		content: '';
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--color-accent);
	}

	:global(.motion) .hero__statement,
	:global(.motion) .hero__tagline,
	:global(.motion) .hero__actions,
	:global(.motion) .hero__facts {
		animation: fade-up 1.1s var(--ease-out) backwards;
	}

	:global(.motion) .hero__statement { animation-delay: 0.45s; }
	:global(.motion) .hero__tagline { animation-delay: 0.6s; }
	:global(.motion) .hero__actions { animation-delay: 0.72s; }
	:global(.motion) .hero__facts { animation-delay: 0.84s; }

	@keyframes fade-up {
		from {
			clip-path: inset(-0.5em -1rem 100% -1rem);
			transform: translateY(1.25rem);
		}
		to {
			clip-path: inset(-0.5em -1rem -0.5em -1rem);
		}
	}

	.hero__device {
		display: flex;
		justify-content: center;
		perspective: 1600px;
	}

	.hero__device :global(.hero__reader) {
		max-width: 21rem;
		transform:
			translate3d(0, calc(var(--p, 0) * -3rem), 0)
			rotateX(calc(8deg - var(--p, 0) * 8deg))
			rotateY(calc(-16deg + var(--p, 0) * 16deg))
			rotateZ(calc(2deg - var(--p, 0) * 2deg));
		transform-style: preserve-3d;
	}

	:global(.motion) .hero__device {
		animation: device-in 1.6s var(--ease-out) 0.2s backwards;
	}

	@keyframes device-in {
		from {
			clip-path: inset(100% -4rem -4rem -4rem);
			transform: translateY(4rem);
		}
		to {
			clip-path: inset(-4rem);
		}
	}

	/* Sample recap on the e-ink screen */
	.recap {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 9% 9% 7%;
		box-sizing: border-box;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(0.7rem, 0.55rem + 0.35vw, 0.86rem);
		line-height: 1.5;
	}

	.recap__head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-bottom: 0.6em;
		border-bottom: 1px solid rgba(43, 36, 32, 0.2);
		font-family: var(--font-body);
		font-size: 0.72em;
		color: var(--ink-soft);
	}

	.recap__logo {
		font-family: var(--font-display);
		font-size: 1.35em;
		color: var(--ink);
	}

	.recap__title {
		margin: 1.1em 0 0.9em;
		font-family: var(--font-display);
		font-size: 1.9em;
		line-height: 1.1;
		color: var(--ink);
	}

	.recap__quote {
		margin: 0;
	}

	.recap__mark {
		background-image: linear-gradient(rgba(43, 36, 32, 0.16), rgba(43, 36, 32, 0.16));
		background-repeat: no-repeat;
		background-size: 100% 100%;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	:global(.motion) .recap__mark {
		animation: eink-mark 1.4s steps(9, end) 1.5s both;
	}

	@keyframes eink-mark {
		from {
			background-size: 0% 100%;
		}
	}

	.recap__quote--next {
		color: var(--ink-soft);
	}

	.recap__book {
		margin-top: 0.6em;
		font-family: var(--font-body);
		font-size: 0.72em;
		color: var(--ink-soft);
	}

	.recap__rule {
		display: block;
		margin: 1.2em 0;
		height: 1px;
		background: rgba(43, 36, 32, 0.16);
	}

	.recap__foot {
		margin-top: auto;
		text-align: center;
		font-family: var(--font-body);
		font-size: 0.68em;
		color: var(--ink-soft);
	}

	.hero__cue {
		position: absolute;
		left: 50%;
		bottom: 1.5rem;
		display: none;
		width: 1.5rem;
		height: 2.4rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 1rem;
		transform: translateX(-50%);
		opacity: calc(1 - var(--p, 0) * 4);
	}

	.hero__cue span {
		position: absolute;
		left: 50%;
		top: 0.45rem;
		width: 2px;
		height: 0.45rem;
		border-radius: 2px;
		background: var(--color-accent);
		transform: translateX(-50%);
	}

	:global(.motion) .hero__cue span {
		animation: cue 2.2s var(--ease-in-out) infinite;
	}

	@keyframes cue {
		0% { transform: translate(-50%, 0); opacity: 0; }
		30% { opacity: 1; }
		80%, 100% { transform: translate(-50%, 0.9rem); opacity: 0; }
	}

	@media (min-width: 60rem) {
		.hero__grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
			gap: 4rem;
		}

		.hero__device :global(.hero__reader) {
			max-width: 24rem;
		}

		.hero__cue {
			display: block;
		}
	}
</style>
