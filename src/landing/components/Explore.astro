---
import { siteConfig } from '../config/site';
import Button from './Button.astro';

const command = 'docker compose --profile app up -d';
---

<section id="explore" class="explore" data-progress="enter">
	<svg class="explore__loop" aria-hidden="true" viewBox="0 0 1200 160" preserveAspectRatio="none" fill="none">
		<path pathLength="1" d="M0 120 C 240 120, 300 30, 600 30 S 960 120, 1200 120" />
		<circle cx="600" cy="30" r="5" />
	</svg>

	<div class="explore__inner wrap">
		<h2 class="headline explore__title" data-reveal>Ready to <span>read again?</span></h2>
		<p class="lede explore__lede" data-reveal style="--d:1">
			Browse the source, read the documentation, and let tonight’s recap bring back something you underlined years ago.
		</p>

		<div class="explore__cmd" data-reveal style="--d:2">
			<code><span aria-hidden="true">$ </span>{command}</code>
			<button type="button" class="explore__copy" data-copy={command} aria-label="Copy command">
				<svg class="explore__copy-idle" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5V3A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" /></svg>
				<svg class="explore__copy-done" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7" /></svg>
			</button>
			<span class="sr-only" aria-live="polite" data-copy-status></span>
		</div>

		<div class="explore__actions" data-reveal style="--d:3">
			<Button href={siteConfig.githubUrl} variant="primary" target="_blank" rel="noopener noreferrer">View on GitHub</Button>
			<Button href={siteConfig.docsUrl} variant="outline">Documentation</Button>
		</div>

		<a class="explore__contribute" href={siteConfig.contributingUrl} target="_blank" rel="noopener noreferrer" data-reveal style="--d:4">
			Contribute
			<svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11 11 5M6 5h5v5" /></svg>
		</a>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.classList.add('is-done');
				if (status) status.textContent = 'Command copied';
				window.setTimeout(() => {
					button.classList.remove('is-done');
					if (status) status.textContent = '';
				}, 1800);
			} catch {
				if (status) status.textContent = 'Copy failed. Select the command and copy it manually.';
			}
		});
	});
</script>

<style>
	.explore {
		position: relative;
		padding-block: clamp(7rem, 14vw, 11rem) clamp(6rem, 12vw, 9rem);
		text-align: center;
		overflow: clip;
	}

	.explore__loop {
		position: absolute;
		top: 1.5rem;
		left: 0;
		width: 100%;
		height: 9rem;
		pointer-events: none;
	}

	.explore__loop path {
		stroke: var(--color-accent);
		stroke-width: 1.25;
		stroke-dasharray: 0.006 0.008;
		opacity: 0.55;
		vector-effect: non-scaling-stroke;
	}

	:global(.motion) .explore__loop path {
		stroke-dashoffset: calc(var(--p, 1) * -0.2);
		opacity: calc(var(--p, 1) * 0.55);
	}

	.explore__loop circle {
		fill: var(--color-accent);
	}

	.explore__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.explore__title {
		font-size: clamp(2.75rem, 1.6rem + 4.6vw, 5.5rem);
	}

	.explore__lede {
		max-width: 34rem;
	}

	.explore__cmd {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		max-width: 100%;
		margin-top: 2.5rem;
		padding: 0.45rem 0.45rem 0.45rem 1.1rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.6rem;
		background: var(--color-panel);
	}

	.explore__cmd code {
		overflow-x: auto;
		white-space: nowrap;
		font: 0.9rem/1.5 var(--font-mono);
		color: var(--color-text);
	}

	.explore__cmd code span {
		color: var(--color-accent);
	}

	.explore__copy {
		position: relative;
		display: grid;
		place-items: center;
		flex: none;
		width: 2.25rem;
		height: 2.25rem;
		border: 0;
		border-radius: 0.4rem;
		background: none;
		color: var(--color-soft);
		cursor: pointer;
		transition:
			background-color 0.2s var(--ease-out),
			color 0.2s var(--ease-out);
	}

	.explore__copy:hover {
		background: color-mix(in srgb, var(--color-text) 7%, transparent);
		color: var(--color-text);
	}

	.explore__copy svg {
		grid-area: 1 / 1;
		width: 1rem;
		height: 1rem;
		transition:
			opacity 0.2s var(--ease-out),
			transform 0.3s var(--ease-out);
	}

	.explore__copy-done {
		opacity: 0;
		transform: scale(0.6);
		color: var(--color-accent);
	}

	.explore__copy.is-done .explore__copy-idle {
		opacity: 0;
		transform: scale(0.6);
	}

	.explore__copy.is-done .explore__copy-done {
		opacity: 1;
		transform: none;
	}

	.explore__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.explore__contribute {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.75rem;
		padding: 0.35rem 0.85rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: 0.875rem;
		color: var(--color-soft);
		text-decoration: none;
		transition:
			border-color 0.25s var(--ease-out),
			color 0.25s var(--ease-out);
	}

	.explore__contribute svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	.explore__contribute:hover {
		border-color: var(--color-accent);
		color: var(--color-text);
	}
</style>
