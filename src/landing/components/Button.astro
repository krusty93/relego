---
interface Props {
	href: string;
	variant?: 'primary' | 'outline';
	class?: string;
	target?: string;
	rel?: string;
	arrow?: boolean;
}

const { href, variant = 'primary', class: className = '', target, rel, arrow = false } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]} target={target} rel={rel}>
	<slot />
	{arrow && (
		<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 8h10M9 4l4 4-4 4" />
		</svg>
	)}
</a>
