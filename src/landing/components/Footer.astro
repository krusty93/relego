---
import { siteConfig } from '../config/site';
---

<footer class="footer">
	<div class="footer__inner wrap">
		<p>{siteConfig.name} · <a href={siteConfig.licenseUrl} target="_blank" rel="noopener noreferrer">{siteConfig.license} License</a></p>
		<p class="footer__links">
			<a href={siteConfig.docsUrl}>Documentation</a>
			<a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href={siteConfig.contributingUrl} target="_blank" rel="noopener noreferrer">Contributing</a>
		</p>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-border);
		font-size: 0.875rem;
		color: var(--color-soft);
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-block: 2rem;
	}

	.footer p {
		margin: 0;
	}

	.footer__links {
		display: flex;
		gap: 1.5rem;
	}

	.footer a {
		text-decoration: underline;
		text-decoration-color: var(--color-border-strong);
		text-underline-offset: 0.2em;
		transition:
			color 0.25s var(--ease-out),
			text-decoration-color 0.25s var(--ease-out);
	}

	.footer a:hover {
		color: var(--color-text);
		text-decoration-color: var(--color-accent);
	}
</style>
